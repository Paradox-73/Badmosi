static func get_club(id: String) -> Dictionary:
	return DATA.get(id, DATA.impulse)


static func room_pal(id: String) -> Dictionary:
	var d := get_club(id)
	var f: Color = Px.col(d.floor)
	return {
		"floor": f.lerp(Px.C.ink, 0.25), "floor2": f.lerp(Px.C.ink, 0.4),
		"wall": Px.col(d.wall).lerp(Px.C.ink, 0.2), "hazard": Px.col(d.hazard),
		"accent": Px.col(d.hazard), "carpet": Px.C.maroon,
	}


static func palette4(id: String) -> Array:
	var out := []
	for h in get_club(id).palette:
		out.append(Color(h))
	return out


## Enemies gain 5% health per club already beaten.
static func hp_mult() -> float:
	return 1.0 + 0.05 * Game.card_count()


